{
  "version": 1,
  "contentPatterns": [
    { "kind": "AWS access key id", "regex": "(?:AKIA|ASIA)[0-9A-Z]{16}", "rightBoundary": true },
    { "kind": "GitHub personal access token", "regex": "ghp_[A-Za-z0-9]{36}", "rightBoundary": true },
    { "kind": "GitHub fine-grained token", "regex": "github_pat_[A-Za-z0-9_]{22,}", "rightBoundary": true },
    { "kind": "GitHub app/OAuth token", "regex": "gh[ousr]_[A-Za-z0-9]{36}", "rightBoundary": true },
    { "kind": "Anthropic API key", "regex": "sk-ant-[A-Za-z0-9-]{20,}", "rightBoundary": true },
    { "kind": "OpenAI API key", "regex": "sk-proj-[A-Za-z0-9_-]{20,}", "rightBoundary": true },
    { "kind": "Slack token", "regex": "xox[baprs]-[A-Za-z0-9-]{10,}", "rightBoundary": true },
    { "kind": "Google API key", "regex": "AIza[0-9A-Za-z_-]{35}", "rightBoundary": true },
    { "kind": "Stripe live key", "regex": "[sr]k_live_[A-Za-z0-9]{20,}", "rightBoundary": true },
    { "kind": "private key (PEM block)", "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----", "rightBoundary": true },
    { "kind": "1Password share link", "regex": "share\\.1password\\.com/s#", "rightBoundary": false }
  ],
  "pathHeuristic": {
    "kind": "credential-related filename",
    "singleTokens": [
      "password",
      "passwords",
      "passwd",
      "passwds",
      "credential",
      "credentials",
      "secret",
      "secrets"
    ],
    "tokenPairs": [
      ["api", "key"],
      ["api", "keys"],
      ["access", "key"],
      ["access", "keys"],
      ["private", "key"],
      ["private", "keys"],
      ["app", "password"],
      ["app", "passwords"]
    ]
  }
}
